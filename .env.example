# ==============================================================================
# SAKTHIMURUGAN MEDICAL AGENCIES (SMM) - ROOT ENVIRONMENT CONFIGURATION
# Wholesale Medical Supplier, Erode, Tamil Nadu
# ==============================================================================

# Node Environment
NODE_ENV=development

# Backend Service
PORT=5000
BACKEND_URL=http://localhost:5000

# Frontend Service
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_jwt_secret_key_for_production
JWT_EXPIRES_IN=7d

# PostgreSQL Database Connection (Prisma ORM)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sakthimurugan_db?schema=public"
