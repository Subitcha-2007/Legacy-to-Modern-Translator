# ==============================================================================
# SAKTHIMURUGAN MEDICAL AGENCIES (SMM) - BACKEND REST API
# Express.js + Prisma ORM + PostgreSQL / File Store Fallback
# ==============================================================================

PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=sakthimurugan_jwt_secret_key_erode_wholesale_2026
JWT_EXPIRES_IN=7d

# PostgreSQL Connection String (Prisma ORM)
# If PostgreSQL is not active, server automatically falls back to backend/data_store.json
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sakthimurugan_db?schema=public

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:3000

# File Upload Storage Directory
UPLOAD_DIR=uploads
